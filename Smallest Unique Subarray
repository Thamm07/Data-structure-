
class Solution:
    def smallestUniqueSubarray(self, nums):
        n = len(nums)

        for k in range(1, n + 1):
            count = {}

            for i in range(n - k + 1):
                sub = tuple(nums[i:i+k])
                count[sub] = count.get(sub, 0) + 1

            for x in count:
                if count[x] == 1:
                    return k

        return n
