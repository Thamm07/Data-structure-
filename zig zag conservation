class Solution(object):
    def convert(self, s, numRows):
        if numRows==1 or numRows>=len(s):
            return s
        rows=[""]*numRows
        row=0
        down=True
        for char in s:
            rows[row] += char
            if row == numRows-1:
                down=False
            elif row==0:
                down=True
            if down==True:
                row+=1
            else:
                row-=1
        return "".join(rows)

        
